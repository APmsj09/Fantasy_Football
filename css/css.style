body {
    background-color: #f8fafc;
    height: 100vh;
    overflow: hidden;
}

.sidebar-shell {
    position: relative;
}

.sidebar-toggle {
    border: 1px solid rgba(255,255,255,0.06);
}

.sidebar-collapsed {
    width: 5rem !important;
}

.sidebar-collapsed .sidebar-title,
.sidebar-collapsed .nav-label,
.sidebar-collapsed .sidebar-footer {
    display: none;
}

.sidebar-collapsed .nav-btn {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

.sidebar-collapsed .nav-btn .nav-label {
    display: none;
}

main {
    scroll-behavior: smooth;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
}

/* Hide scrollbar for Chrome, Safari and Opera but keep functionality */
.hide-scrollbar::-webkit-scrollbar {
    display: none;
}
.hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
}

/* Custom stylish scrollbar for tables/content */
.table-container, .roster-content, main {
    overflow-y: auto;
}
.table-container {
    overflow: auto;
    position: relative;
}
.table-container table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
}
.table-container thead th {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: #f8fafc;
}
.table-container::-webkit-scrollbar, .roster-content::-webkit-scrollbar, main::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
.table-container::-webkit-scrollbar-track, .roster-content::-webkit-scrollbar-track, main::-webkit-scrollbar-track {
    background: transparent; 
}
.table-container::-webkit-scrollbar-thumb, .roster-content::-webkit-scrollbar-thumb, main::-webkit-scrollbar-thumb {
    background: #cbd5e1; 
    border-radius: 10px;
}
.table-container::-webkit-scrollbar-thumb:hover, main::-webkit-scrollbar-thumb:hover {
    background: #94a3b8; 
}

/* Sidebar Navigation Buttons */
.nav-btn {
    transition: all 0.2s ease-in-out;
    color: #94a3b8; /* slate-400 */
}
.nav-btn:hover {
    background-color: #1e293b; /* slate-800 */
    color: #f8fafc;
}
.nav-btn.active {
    background-color: #4f46e5; /* indigo-600 */
    color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* Roster Tabs */
.tab {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #64748b;
    border-radius: 0.5rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
}
.tab.active {
    background-color: #e0e7ff; /* indigo-100 */
    color: #4338ca; /* indigo-700 */
}
.tab:not(.active):hover {
    background-color: #f1f5f9;
    color: #334155;
}

/* Screen Management */
.screen { display: none; }
.screen.active { display: block; animation: fadeIn 0.3s ease-in-out; }
.screen.active.grid { display: grid; }
.screen.active.flex { display: flex; }

.modal-panel {
    display: flex;
    flex-direction: column;
}

#message-modal-content {
    max-height: min(60vh, 42rem);
    overflow-y: auto;
    padding-right: 0.25rem;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}