body {
    font-family: 'Inter', sans-serif;
}
.table-container {
    max-height: 500px;
    overflow-y: auto;
}
.roster-content {
    max-height: 400px;
    overflow-y: auto;
}

.table-container::-webkit-scrollbar, .roster-content::-webkit-scrollbar {
    width: 8px;
    background-color: #f1f1f1;
    border-radius: 4px;
}
.table-container::-webkit-scrollbar-thumb, .roster-content::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 4px;
}
.table-container::-webkit-scrollbar-thumb:hover, .roster-content::-webkit-scrollbar-thumb:hover {
    background-color: #94a3b8;
}

.tab {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem 0.5rem 0 0;
    cursor: pointer;
    margin-bottom: -1px;
}
.tab.active {
    color: #4f46e5;
    border-color: #4f46e5;
    font-weight: 600;
    background-color: white;
}
.tab:not(.active) {
    background-color: #f9fafb;
}
.tab:not(.active):hover {
    background-color: #f3f4f6;
}

canvas {
    width: 100% !important;
    height: auto !important;
}

.nav-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-weight: 500;
    transition: background-color 0.2s;
}
.nav-btn:hover { background-color: rgba(255,255,255,0.1); }
.nav-btn.active { background-color: rgba(255,255,255,0.2); }
.screen { display: none; }
.screen.active { display: block; }